# Google OAuth2 — https://console.cloud.google.com/ 에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 암호화 키 — python -c "import secrets; print(secrets.token_hex(32))" 로 생성
SESSION_SECRET=

# 환경 구분: 프로덕션이면 true, 로컬 개발이면 false
IS_PRODUCTION=false

# NVIDIA GPU 사용 시 필요 (GPU 없으면 제거해도 됨)
NVIDIA_DISABLE_REQUIRE=1
